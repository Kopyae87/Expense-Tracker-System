<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ExpenseReport" pageWidth="595" pageHeight="842" columnWidth="555"
    leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="exp-001">

    <!-- Styles -->
    <style name="Table_TH" mode="Opaque" backcolor="#F0F8FF">
        <box>
            <pen lineWidth="0.5" lineColor="#000000"/>
        </box>
    </style>
    <style name="Table_CH" mode="Opaque" backcolor="#BFE1FF">
        <box>
            <pen lineWidth="0.5" lineColor="#000000"/>
        </box>
    </style>
    <style name="Table_TD" mode="Opaque" backcolor="#FFFFFF">
        <box>
            <pen lineWidth="0.5" lineColor="#000000"/>
        </box>
    </style>

    <!-- Parameters -->
    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="ReportDate" class="java.util.Date"/>

    <!-- Fields -->
    <field name="categoryName" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="description" class="java.lang.String"/>
    <field name="expenseDate" class="java.util.Date"/>
    <field name="paymentType" class="java.lang.String"/>

    <!-- Page Header -->
    <pageHeader>
        <band height="50">
            <textField>
                <reportElement x="0" y="0" width="555" height="30" uuid="title-001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="30" width="555" height="20" uuid="date-001"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Date: "+ new java.text.SimpleDateFormat("dd-MM-yyyy").format($P{ReportDate})]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="Table_CH" x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement style="Table_CH" x="50" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement style="Table_CH" x="150" y="0" width="200" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement style="Table_CH" x="350" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Amount]]></text>
            </staticText>
            <staticText>
                <reportElement style="Table_CH" x="450" y="0" width="105" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Expense Date]]></text>
            </staticText>
            <staticText>
                <reportElement style="Table_CH" x="555" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Payment Type]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="20">
            <textField>
                <reportElement style="Table_TD" x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Table_TD" x="50" y="0" width="100" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[$F{categoryName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Table_TD" x="150" y="0" width="200" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement style="Table_TD" x="350" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField pattern="dd-MM-yyyy">
                <reportElement style="Table_TD" x="450" y="0" width="105" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{expenseDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Table_TD" x="555" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{paymentType}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary -->
    <summary>
        <band height="30">
            <textField pattern="#,##0.00">
                <reportElement x="350" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" isBold="true"/>
                <textFieldExpression><![CDATA[$V{amount_SUM}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="250" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" isBold="true"/>
                <text><![CDATA[Total Amount:]]></text>
            </staticText>
        </band>
    </summary>

    <!-- Variables -->
    <variable name="amount_SUM" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

</jasperReport>
